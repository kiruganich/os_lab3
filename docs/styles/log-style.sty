% ---------------------------------------------------------------------------
% Оформление листингов.
%
% Особенность: исходники лабораторной содержат комментарии на русском языке,
% а штатный listings + inputenc=utf8 не умеет обрабатывать многобайтовые
% символы (ошибка "Invalid UTF-8 byte sequence"). Решение - таблица литералов
% (literate), которая сопоставляет каждой кириллической букве команду
% \cyr... из пакета babel-russian. Эти команды печатают символ в текущей
% кодировке шрифта (T2B), поэтому текст в листинге выводится корректно.
% ---------------------------------------------------------------------------
% columns=fixed (а не fullflexible): при гибких колонках listings не умеет
% корректно обрабатывать многобайтовые символы кириллицы в паре с таблицей
% литералов (ошибка "Invalid UTF-8 byte sequence"). При фиксированных
% колонках вывод корректен.
\lstset{tabsize=2,
	breaklines,
	columns=fixed,
	numbers=left,
	numberstyle={\footnotesize},
	extendedchars,
	inputencoding=utf8,
	commentstyle=\color{gray},
	showstringspaces=false,
	basicstyle=\footnotesize\ttfamily,
	frame=L,
	xleftmargin=\parindent,
	captionpos=b}

\def\@xobeysp{ }
\def\verbatim@processline{\hspace{1.2cm}\raggedright\the\verbatim@line\par}

\parindent=0pt
\parskip=3pt

\definecolor{lightgray}{gray}{0.9}

\renewcommand{\thesubsection}{\arabic{subsection}}

\lstdefinestyle{customc}{
  belowcaptionskip=1\baselineskip,
  breaklines=true,
  frame=L,
  xleftmargin=\parindent,
  language=C,
  showstringspaces=false,
  basicstyle=\footnotesize\ttfamily,
  keywordstyle=\bfseries\color{green!40!black},
  commentstyle=\color{gray},
  identifierstyle=\color{black},
  stringstyle=\color{blue},
}

\lstdefinestyle{customasm}{
  belowcaptionskip=1\baselineskip,
  frame=L,
  xleftmargin=\parindent,
  language=[x86masm]Assembler,
  basicstyle=\footnotesize\ttfamily,
  commentstyle=\itshape\color{purple!40!black},
}

